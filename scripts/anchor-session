#!/bin/bash
# Anchor Wayland 会话 — 由显示管理器 (GDM/SDDM/LightDM) 调用
# 通过 libseat (logind) 获取 DRM master，不使用 --direct

# 通过符号链接跟踪到真实路径
SELF="$(readlink -f "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SELF")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

# ─── 确定 anchor 二进制路径 ───
# 优先使用开发构建，回退到系统安装
if [ -x "$PROJECT_DIR/target/release/anchor" ]; then
    ANCHOR_BIN="$PROJECT_DIR/target/release/anchor"
elif command -v anchor &>/dev/null; then
    ANCHOR_BIN="$(command -v anchor)"
else
    echo "[anchor-session] 错误: 找不到 anchor 二进制文件" >&2
    exit 1
fi

# ─── 通用环境变量 ───
export TERMINAL="${TERMINAL:-foot}"
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=anchor
export MOZ_ENABLE_WAYLAND=1
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
export SDL_VIDEODRIVER=wayland

# Electron/Chromium Wayland 支持
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export CHROME_FLAGS="--ozone-platform=wayland --enable-features=UseOzonePlatform"

# ─── GPU 自动检测 ───
detect_gpu() {
    # 读取所有 DRM 设备的 vendor
    for card in /sys/class/drm/card[0-9]*; do
        [ -d "$card" ] || continue
        device_link="$card/device"
        [ -L "$device_link" ] || continue
        
        vendor_path="$device_link/vendor"
        [ -f "$vendor_path" ] || continue
        vendor=$(cat "$vendor_path" 2>/dev/null)
        
        case "$vendor" in
            0x10de) echo "nvidia"; return ;;
            0x1002) echo "amd"; return ;;
            0x8086) echo "intel"; return ;;
        esac
    done
    
    # fallback: 检查内核模块
    if lsmod 2>/dev/null | grep -q nvidia; then
        echo "nvidia"
    elif lsmod 2>/dev/null | grep -q amdgpu; then
        echo "amd"
    elif lsmod 2>/dev/null | grep -q i915; then
        echo "intel"
    else
        echo "unknown"
    fi
}

GPU_TYPE=$(detect_gpu)
echo "[anchor-session] 检测到 GPU: $GPU_TYPE" >> /tmp/anchor-session.log 2>/dev/null

case "$GPU_TYPE" in
    nvidia)
        # NVIDIA proprietary driver 环境变量
        export GBM_BACKEND=nvidia-drm
        export __GLX_VENDOR_LIBRARY_NAME=nvidia
        export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
        # 需要启用 DRM KMS modeset
        if [ ! -f /sys/module/nvidia_drm/parameters/modeset ]; then
            echo "[anchor-session] 警告: nvidia-drm.modeset 未启用，请添加 nvidia-drm.modeset=1 到内核参数" >&2
        fi
        ;;
    amd)
        # AMD — 使用 Mesa GBM/AMDGPU，通常无需特殊配置
        export GBM_BACKEND=amdgpu
        unset __GLX_VENDOR_LIBRARY_NAME
        unset __EGL_VENDOR_LIBRARY_FILENAMES
        ;;
    intel)
        # Intel — 使用 Mesa i915/iris
        unset GBM_BACKEND
        unset __GLX_VENDOR_LIBRARY_NAME
        unset __EGL_VENDOR_LIBRARY_FILENAMES
        ;;
    *)
        # 未知 GPU — 尝试默认配置
        echo "[anchor-session] 警告: 未检测到 GPU 类型，使用默认配置" >&2
        ;;
esac

# ─── 输入法配置 ───
IM_METHOD="none"
CONFIG_FILE=""
for f in "$HOME/.config/anchor/config.toml" "$PROJECT_DIR/config.toml" "/usr/local/share/doc/anchor/config.toml.example" "/usr/share/doc/anchor/config.toml.example"; do
    if [ -f "$f" ]; then CONFIG_FILE="$f"; break; fi
done
if [ -n "$CONFIG_FILE" ]; then
    IM_METHOD=$(grep -A1 '\[input_method\]' "$CONFIG_FILE" 2>/dev/null | grep 'method' | sed 's/.*=.*"\(.*\)".*/\1/' | head -1)
    IM_METHOD="${IM_METHOD:-none}"
fi

case "$IM_METHOD" in
    fcitx)
        export GTK_IM_MODULE=fcitx
        export QT_IM_MODULE=fcitx
        export XMODIFIERS=@im=fcitx
        export SDL_IM_MODULE=fcitx
        export INPUT_METHOD=fcitx
        # fcitx5 由 Anchor 合成器在 socket 就绪后启动
        ;;
    ibus)
        export GTK_IM_MODULE=ibus
        export QT_IM_MODULE=ibus
        export XMODIFIERS=@im=ibus
        export SDL_IM_MODULE=ibus
        export INPUT_METHOD=ibus
        if command -v ibus-daemon &>/dev/null; then
            ibus-daemon -drx 2>/dev/null &
        fi
        ;;
esac

# ─── 确保 XDG_RUNTIME_DIR ───
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR"

# ─── 预设 WAYLAND_DISPLAY ───
# Anchor 使用 "wayland-anchor" 作为 socket 名称（硬编码在 src/main.rs）。
# 必须在 exec 之前 export，这样：
#   1. systemd 用户服务（xdg-desktop-portal-*）的 ConditionEnvironment 能通过
#   2. 子进程（终端、应用）继承正确的 WAYLAND_DISPLAY
# Sway/Hyprland 等合成器都这样做。
export WAYLAND_DISPLAY=wayland-anchor

# ─── Session 守护进程恢复（仅对 session 内重启有效）───
# 注意：电源键物理重启场景下，这段代码**不起作用**——全新 session 启动
# 时没有 keyring 加密密钥，gnome-keyring-daemon 即使启动也是 locked 状态。
# 电源键重启后找回浏览器登录态的**唯一方法**：
#   1. 取消 GDM 的 AutomaticLogin（/etc/gdm3/custom.conf 中注释掉）
#   2. 电源键重启 → GDM 显示登录页 → 输入密码
#   3. GDM 用你输入的密码解锁 GNOME Keyring（密码=keyring 密码）
#   4. 浏览器、TLS 证书、密码管理器全部恢复
#
# 这里保留 dbus-update-activation-environment 和 gnome-keyring-daemon
# 启动逻辑，仅对 `kill $(pgrep anchor)` 后再启动 anchor 的场景有效
# （session 内进程替换，D-Bus session bus 仍存活）。
if command -v dbus-update-activation-environment &>/dev/null; then
    dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP \
        XDG_RUNTIME_DIR GTK_IM_MODULE QT_IM_MODULE XMODIFIERS 2>/dev/null
fi

if command -v gnome-keyring-daemon &>/dev/null && \
   [ -z "$GNOME_KEYRING_CONTROL" ]; then
    eval $(gnome-keyring-daemon --start --replace --components=secrets,ssh 2>/dev/null)
fi

# ─── 激活 systemd graphical-session.target ───
# 这是标准做法：Sway/Hyprland 等 wlroots 合成器都这样做。
# 激活后 systemd 用户服务（包括 xdg-desktop-portal-*）会看到
# WAYLAND_DISPLAY 已设置并自动启动。
if command -v systemctl &>/dev/null; then
    systemctl --user import-environment WAYLAND_DISPLAY DISPLAY \
        XDG_SESSION_TYPE XDG_CURRENT_DESKTOP XDG_RUNTIME_DIR 2>/dev/null || true
    systemctl --user start graphical-session.target 2>/dev/null || true
fi

# ─── 启动 xdg-desktop-portal ───
# 即使 systemd 用户服务没起来，也直接以后台进程启动。
# 按优先级尝试后端：gtk → wlr（自动回退）。
# WAYLAND_DISPLAY 已在上面 export，子进程自动继承。
PORTAL_BACKEND=""
for candidate in /usr/libexec/xdg-desktop-portal-gtk \
                  /usr/libexec/xdg-desktop-portal-wlr \
                  /usr/lib/xdg-desktop-portal-gtk \
                  /usr/lib/xdg-desktop-portal-wlr; do
    if [ -x "$candidate" ]; then
        "$candidate" &
        PORTAL_BACKEND="$candidate"
        break
    fi
done

if [ -x /usr/libexec/xdg-desktop-portal ]; then
    /usr/libexec/xdg-desktop-portal &
elif [ -x /usr/lib/xdg-desktop-portal ]; then
    /usr/lib/xdg-desktop-portal &
fi

exec "$ANCHOR_BIN" 2>&1 | tee /tmp/anchor-session.log
